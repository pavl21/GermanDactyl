--- a/resources/scripts/api/http.ts
+++ b/resources/scripts/api/http.ts
@@ -64,6 +64,22 @@ export function httpErrorToHuman(error: any): string {
         }
     }
 
+    // Translate the generic (English) error messages generated by axios itself.
+    if (typeof error.message === 'string') {
+        if (error.message === 'Network Error') {
+            return 'Netzwerkfehler: Bitte prüfe deine Verbindung und versuche es erneut.';
+        }
+
+        const status = error.message.match(/^Request failed with status code (\d+)$/);
+        if (status) {
+            return `Die Anfrage ist fehlgeschlagen (Statuscode ${status[1]}).`;
+        }
+
+        if (/^timeout of \d+ms exceeded$/.test(error.message)) {
+            return 'Zeitüberschreitung bei der Anfrage. Bitte versuche es erneut.';
+        }
+    }
+
     return error.message;
 }
 
